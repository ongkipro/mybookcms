---
import MalaysiaCheckoutForm from './MalaysiaCheckoutForm.astro';
import '../../../styles/form-hybrid.css';

interface Props {
  province?: string;
  bannerImage?: string;
  productSlug?: string;
  selectedVariantId?: string;
  embedded?: boolean;
}

const { productSlug = 'asahan-portable', selectedVariantId, embedded = false, bannerImage } = Astro.props;
---

<div class="mx-auto w-full max-w-[480px] bg-white" data-canonical-order-form>
  <MalaysiaCheckoutForm productSlug={productSlug} selectedVariantId={selectedVariantId} embedded={embedded} bannerImage={bannerImage} />
</div>
