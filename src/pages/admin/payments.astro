---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import DokuPaymentSettings, { CodAvailability } from '../../components/admin/DokuPaymentSettings';
import SellerBankAccounts from '../../components/admin/SellerBankAccounts';

export const prerender = false;
---

<AdminLayout title="Metode Pembayaran" activeMenu="payments">
  <main class="max-w-5xl space-y-5">
    <AdminPageHeader
      eyebrow="Pembayaran"
      title="Metode pembayaran"
      description="Kelola COD, rekening transfer manual, dan hosted payment DOKU Malaysia."
    />

    <DokuPaymentSettings client:load />

    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6" aria-labelledby="manual-payment-heading">
      <h2 id="manual-payment-heading" class="text-lg font-bold text-slate-950">Pembayaran manual</h2>
      <p class="mt-1 text-sm leading-6 text-slate-600">Atur ketersediaan COD dan rekening untuk transfer bank manual.</p>
      <CodAvailability client:load />
      <SellerBankAccounts client:load />
    </section>
  </main>
</AdminLayout>
