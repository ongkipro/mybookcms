---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SellerBankAccounts from '../../components/admin/SellerBankAccounts';

export const prerender = false;
---

<AdminLayout title="Metode Pembayaran" activeMenu="payments">
  <div class="max-w-5xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-semibold text-slate-600">Payments</p>
    <h1 class="mt-1 text-2xl font-black text-slate-950">COD & transfer bank manual</h1>
    <p class="mt-3 text-sm leading-6 text-slate-600">
      Checkout hanya menawarkan COD dan transfer bank manual. Tambahkan atau ubah rekening penerima dari pengaturan toko.
    </p>
    <SellerBankAccounts client:load />
  </div>
</AdminLayout>
