---
import GeoIpResolvedForm from '../../components/storefront/forms/GeoIpResolvedForm.astro';
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import { getStorefrontProduct } from '../../lib/catalog';
import { detectStaleEmbedSnippet } from '../../lib/embed-markup';
import { resolveFormVariant } from '../../lib/form-config';

export const prerender = false;

// A pasted snippet never updates on deploy, so this frame is the only place the
// store can see which generation a merchant page is still running. Logged, never
// stored, and carries nothing about the visitor — just the parent origin.
const staleSnippet = detectStaleEmbedSnippet({
  versionParam: Astro.url.searchParams.get('v'),
  referer: Astro.request.headers.get('referer'),
  selfOrigin: Astro.url.origin,
});
if (staleSnippet) {
  console.warn(
    'embed-snippet-stale',
    `parent ${staleSnippet.parent}, snippet v${staleSnippet.snippetVersion}, current v${staleSnippet.currentVersion}`,
  );
}

const productKey = Astro.url.searchParams.get('product_id')?.trim() ?? '';
const variantKey = Astro.url.searchParams.get('variant_id')?.trim();
const product = productKey
  ? await getStorefrontProduct(Astro.locals, productKey)
  : undefined;
const selectedVariant = product
  ? resolveFormVariant(product, variantKey)
  : undefined;

let errorMessage = '';
if (!productKey) {
  Astro.response.status = 400;
  errorMessage = 'Product ID diperlukan.';
} else if (!product) {
  Astro.response.status = 404;
  errorMessage = 'Produk tidak aktif atau belum tersedia untuk checkout.';
} else if (!selectedVariant) {
  Astro.response.status = 404;
  errorMessage = 'Varian tidak aktif atau tidak tersedia.';
}

const title = product
  ? `Borang Pesanan ${product.productName} - ${Astro.locals.tenant.name}`
  : `Borang Pesanan - ${Astro.locals.tenant.name}`;
---

<EmbedLayout title={title}>
  {
    errorMessage || !product || !selectedVariant ? (
      <main class="flex min-h-72 items-center justify-center p-6">
        <section class="w-full rounded-xl border border-amber-200 bg-amber-50 p-5 text-center" role="alert">
          <h1 class="text-base font-bold text-slate-950">Borang belum tersedia</h1>
          <p class="mt-2 text-sm leading-6 text-amber-900">{errorMessage}</p>
        </section>
      </main>
    ) : (
      <GeoIpResolvedForm productSlug={product.slug} selectedVariantId={selectedVariant.id} />
    )
  }

  <script is:inline>
    (() => {
      if (window.parent === window) return;
      let parentOrigin = '';
      try {
        parentOrigin = document.referrer ? new URL(document.referrer).origin : '';
      } catch {
        return;
      }
      if (!parentOrigin) return;

      let lastHeight = 0;
      const reportHeight = () => {
        const height = Math.ceil(document.documentElement.scrollHeight);
        if (height === lastHeight) return;
        lastHeight = height;
        window.parent.postMessage(
          { type: 'mybook:embed-resize', height },
          parentOrigin,
        );
      };

      new ResizeObserver(reportHeight).observe(document.body);
      window.addEventListener('load', reportHeight, { once: true });
      reportHeight();
    })();
  </script>
</EmbedLayout>
