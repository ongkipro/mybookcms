---
import PageIntro from '../../components/storefront/shared/PageIntro.astro';
import Icon from '../../components/storefront/shared/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listPublicLandingPages } from '../../lib/landing-pages';

export const prerender = false;

// Read-only: unlike the admin list this never reconciles the native register,
// because a storefront request must not write to the store.
const pages = await listPublicLandingPages(Astro.locals);
const INITIAL_COUNT = 10;
const copy = { page: 'Halaman', pages: 'Halaman', all: 'Semua halaman', home: 'Laman utama', intro: 'Halaman tawaran yang aktif. Pilih satu untuk melihat butiran dan membuat pesanan.', list: 'Senarai halaman', showing: 'Memaparkan', of: 'daripada', more: 'Lihat lagi halaman', empty: 'Belum ada halaman', emptyText: 'Halaman tawaran akan muncul di sini selepas diterbitkan.' };
---

<BaseLayout
  title={`${copy.pages} - ${Astro.locals.tenant.name}`}
  description={`Senarai halaman tawaran ${Astro.locals.tenant.name}.`}
  breadcrumbs={[
    { name: copy.home, url: '/' },
    { name: copy.pages, url: '/landing-page' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-white text-[#111111]">
    <PageIntro
      badge={copy.all}
      title={`${copy.pages} ${Astro.locals.tenant.name}`}
      description={copy.intro}
      breadcrumbs={[{ label: copy.home, href: '/' }, { label: copy.pages }]}
    />

    <section aria-label={copy.list} class="mx-auto max-w-[480px] px-4 py-8">
      {pages.length > 0 ? (
        <>
          <ul class="flex flex-col" id="landing-list">
            {pages.map((page, index) => (
              <li
                class={`landing-list-item border-fade-t first:border-t-0 ${index >= INITIAL_COUNT ? 'hidden' : ''}`}
                data-index={index}
              >
                <a
                  href={page.href}
                  class="flex min-h-14 items-center justify-between gap-3 py-3.5 transition-colors hover:bg-[#F5F5F5]"
                >
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-semibold text-[#111111]">
                      {page.title}
                    </span>
                    {page.excerpt && (
                      <span class="mt-0.5 block truncate text-xs font-normal text-[#555555]">
                        {page.excerpt}
                      </span>
                    )}
                  </span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 shrink-0 text-[#767676]"
                    aria-hidden="true"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>

          {pages.length > INITIAL_COUNT && (
            <div class="mt-8 flex flex-col items-center gap-3" id="load-more-container">
              <p class="text-[11px] font-normal text-[#555555]">
                {copy.showing} <span id="visible-count" class="font-semibold text-[#111111]">{Math.min(INITIAL_COUNT, pages.length)}</span> {copy.of}{' '}
                <span id="total-count" class="font-semibold text-[#111111]">{pages.length}</span> {copy.pages.toLowerCase()}
              </p>
              <button
                id="load-more-btn"
                type="button"
                class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-none border border-[#111111] bg-[#111111] px-6 py-2.5 text-[10px] font-semibold uppercase tracking-[0.1em] text-white transition-colors hover:bg-[#000000] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
              >
                <span>{copy.more}</span>
                <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
              </button>
            </div>
          )}
        </>
      ) : (
        <div class="border-fade-y py-10 text-center">
          <h2 class="text-lg font-semibold text-[#111111]">{copy.empty}</h2>
          <p class="mt-2 text-sm leading-6 text-[#555555]">
            {copy.emptyText}
          </p>
        </div>
      )}
    </section>
  </main>

  <script>
    const INITIAL_COUNT = 10;
    const STEP = 10;
    let visibleCount = INITIAL_COUNT;

    const items = document.querySelectorAll<HTMLElement>('.landing-list-item');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const visibleCountEl = document.getElementById('visible-count');

    if (loadMoreBtn && items.length > 0) {
      loadMoreBtn.addEventListener('click', () => {
        const nextCount = Math.min(visibleCount + STEP, items.length);
        for (let i = visibleCount; i < nextCount; i++) {
          items[i]?.classList.remove('hidden');
        }
        visibleCount = nextCount;
        if (visibleCountEl) visibleCountEl.textContent = String(visibleCount);
        if (visibleCount >= items.length) loadMoreBtn.classList.add('hidden');
      });
    }
  </script>
</BaseLayout>
