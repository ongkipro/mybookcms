---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const copy = {
  eyebrow: 'Pesanan', title: 'Status pesanan', intro: 'Semak status semasa menggunakan nombor pesanan dan kod status selamat yang diberikan selepas checkout.',
  order: 'Nombor pesanan', token: 'Kod status selamat', check: 'Semak status', checking: 'Menyemak…',
  statusNote: 'Kemas kini lanjut akan dihantar terus melalui WhatsApp.', retry: 'Cuba lagi',
  invalid: 'Pesanan atau kod status selamat tidak dapat disahkan.', failed: 'Status pesanan tidak dapat dimuatkan sekarang. Sila cuba lagi.',
  pending: 'Pesanan diterima', processing: 'Sedang diproses', shipped: 'Dalam penghantaran', delivered: 'Telah dihantar', returned: 'Dipulangkan', cancelled: 'Dibatalkan',
};
---

<BaseLayout title={`${copy.title} — ${Astro.locals.tenant.name}`} description={copy.intro} noindex={true}>
  <main class="min-h-[70vh] bg-white px-5 py-10 text-[#111111]">
    <section class="mx-auto max-w-[440px]">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[#767676]">{copy.eyebrow}</p>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">{copy.title}</h1>
      <p class="mt-2 text-sm leading-6 text-[#555555]">{copy.intro}</p>

      <form id="order-status-form" class="mt-7 grid gap-4 border-y border-[#E5E5E5] py-6" novalidate>
        <label class="grid gap-1.5 text-xs font-semibold text-[#333333]">
          {copy.order}
          <input id="order-number" name="order_number" required autocomplete="off" maxlength="80" class="min-h-11 border border-[#CFCFCF] bg-white px-3 text-base outline-none focus:border-[#111111] focus:ring-2 focus:ring-[#111111]/15" />
        </label>
        <label class="grid gap-1.5 text-xs font-semibold text-[#333333]">
          {copy.token}
          <input id="status-token" name="status_token" required autocomplete="off" maxlength="160" class="min-h-11 border border-[#CFCFCF] bg-white px-3 font-mono text-base outline-none focus:border-[#111111] focus:ring-2 focus:ring-[#111111]/15" />
        </label>
        <button id="status-submit" type="submit" class="min-h-11 bg-[#111111] px-5 text-sm font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]">{copy.check}</button>
      </form>

      <div id="status-error" class="mt-5 hidden border border-[#D9B4B4] bg-[#FFF7F7] p-4 text-sm text-[#8A1C1C]" role="alert" tabindex="-1"></div>
      <section id="status-result" class="mt-5 hidden border border-[#E5E5E5] bg-white p-5" aria-live="polite" aria-busy="false">
        <p id="status-order" class="font-mono text-xs text-[#767676]"></p>
        <h2 id="status-heading" class="mt-2 text-xl font-semibold"></h2>
        <p class="mt-3 text-sm leading-6 text-[#555555]">{copy.statusNote}</p>
      </section>
    </section>
  </main>

  <script is:inline define:vars={{ copy }}>
    const form = document.getElementById('order-status-form');
    const orderInput = document.getElementById('order-number');
    const tokenInput = document.getElementById('status-token');
    const submit = document.getElementById('status-submit');
    const errorBox = document.getElementById('status-error');
    const result = document.getElementById('status-result');

    const statusLabels = {
      pending: copy.pending,
      processing: copy.processing,
      shipped: copy.shipped,
      delivered: copy.delivered,
      returned: copy.returned,
      cancelled: copy.cancelled,
    };
    const setText = (id, value) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value || '';
    };
    const credentials = (() => {
      const hash = new URLSearchParams(location.hash.replace(/^#/, ''));
      if (hash.get('order') && hash.get('token')) {
        history.replaceState(null, '', `${location.pathname}${location.search}`);
        return { order_id: hash.get('order'), status_token: hash.get('token') };
      }
      try { return JSON.parse(sessionStorage.getItem('thanks_state') || 'null'); } catch { return null; }
    })();
    if (credentials) {
      orderInput.value = credentials.order_id || credentials.order_pk || '';
      tokenInput.value = credentials.status_token || '';
    }

    const checkStatus = async () => {
      if (!form.reportValidity()) return;
      errorBox.classList.add('hidden');
      result.classList.add('hidden');
      result.setAttribute('aria-busy', 'true');
      submit.disabled = true;
      submit.textContent = copy.checking;
      try {
        const response = await fetch('/api/order-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ order_id: orderInput.value.trim(), status_token: tokenInput.value.trim() }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) {
          throw new Error(response.status === 404 ? copy.invalid : copy.failed);
        }
        const currentStatus = String(payload.status || 'pending').toLowerCase();
        setText('status-order', payload.order_number);
        setText('status-heading', statusLabels[currentStatus] || statusLabels.processing);
        result.classList.remove('hidden');
      } catch (error) {
        errorBox.textContent = error instanceof Error ? error.message : copy.failed;
        errorBox.classList.remove('hidden');
        errorBox.focus();
      } finally {
        result.setAttribute('aria-busy', 'false');
        submit.disabled = false;
        submit.textContent = copy.check;
      }
    };
    form?.addEventListener('submit', (event) => { event.preventDefault(); void checkStatus(); });
    if (orderInput.value && tokenInput.value) void checkStatus();
  </script>
</BaseLayout>
