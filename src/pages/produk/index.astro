---
import PageIntro from '../../components/storefront/shared/PageIntro.astro';
import ProductListItem from '../../components/storefront/shared/ProductListItem.astro';
import Icon from '../../components/storefront/shared/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatMyr } from '../../lib/storefront-locale';
import { getStorefrontProducts } from '../../lib/catalog';

const products = await getStorefrontProducts(Astro.locals);
const INITIAL_COUNT = 10;
const copy = { products: 'Produk', all: 'Semua produk', home: 'Laman utama', intro: 'Pilih produk mengikut keperluan anda, kemudian lihat pilihan dan harga sebelum membuat pesanan.', list: 'Senarai produk', showing: 'Memaparkan', of: 'daripada', more: 'Lihat lagi produk', empty: 'Katalog sedang disediakan', emptyText: 'Produk akan muncul selepas kandungan dan pilihannya diterbitkan.' };
---

<BaseLayout
  title={`${copy.products} - ${Astro.locals.tenant.name}`}
  description={`Lihat pilihan, ketersediaan dan harga produk ${Astro.locals.tenant.name} sebelum membuat pesanan.`}
  breadcrumbs={[
    { name: copy.home, url: '/' },
    { name: copy.products, url: '/produk' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-white text-[#111111]">
    <PageIntro
      badge={copy.all}
      title={`${copy.products} ${Astro.locals.tenant.name}`}
      description={copy.intro}
      breadcrumbs={[{ label: copy.home, href: '/' }, { label: copy.products }]}
    />

    <section aria-label={copy.list} class="mx-auto max-w-[480px] px-4 py-8">
      {products.length > 0 ? (
        <>
          <div class="grid grid-cols-2 gap-3" id="product-grid">
            {products.map((product, index) => (
              <div class={`product-card-item ${index >= INITIAL_COUNT ? 'hidden' : ''}`} data-index={index}>
                <ProductListItem product={product} priority={index < 2} formatPrice={(value) => formatMyr(value, Astro.locals.tenant.locale)} />
              </div>
            ))}
          </div>

          {products.length > INITIAL_COUNT && (
            <div class="mt-8 flex flex-col items-center gap-3" id="load-more-container">
              <p class="text-[11px] font-normal text-[#555555]">
                {copy.showing} <span id="visible-count" class="font-semibold text-[#111111]">{Math.min(INITIAL_COUNT, products.length)}</span> {copy.of} <span id="total-count" class="font-semibold text-[#111111]">{products.length}</span> {copy.products.toLowerCase()}
              </p>
              <button
                id="load-more-btn"
                type="button"
                class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-none border border-[#111111] bg-[#111111] px-6 py-2.5 text-[10px] font-semibold uppercase tracking-[0.1em] text-white transition-colors hover:bg-[#000000] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
              >
                <span>{copy.more}</span>
                <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
              </button>
            </div>
          )}
        </>
      ) : (
        <div class="border-fade-y py-10 text-center">
          <h2 class="text-lg font-semibold text-[#111111]">{copy.empty}</h2>
          <p class="mt-2 text-sm leading-6 text-[#555555]">{copy.emptyText}</p>
        </div>
      )}
    </section>
  </main>

  <script>
    const INITIAL_COUNT = 10;
    const STEP = 10;
    let visibleCount = INITIAL_COUNT;

    const items = document.querySelectorAll<HTMLElement>('.product-card-item');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const visibleCountEl = document.getElementById('visible-count');

    if (loadMoreBtn && items.length > 0) {
      loadMoreBtn.addEventListener('click', () => {
        const nextCount = Math.min(visibleCount + STEP, items.length);
        for (let i = visibleCount; i < nextCount; i++) {
          if (items[i]) {
            items[i].classList.remove('hidden');
          }
        }
        visibleCount = nextCount;
        if (visibleCountEl) {
          visibleCountEl.textContent = String(visibleCount);
        }
        if (visibleCount >= items.length) {
          loadMoreBtn.classList.add('hidden');
        }
      });
    }
  </script>
</BaseLayout>
